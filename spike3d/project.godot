; 3D spike (Nov 16): a separate Godot project, NOT part of the shipped game.
; The main game never loads anything from this folder (Godot skips sub-folders that hold a project.godot).
config_version=5

[application]

config/name="Duff Quest 3D spike"
run/main_scene="res://town3d.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
