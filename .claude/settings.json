{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; [ ! -f \"$G\" ] || python3 \"$G\""
          }
        ]
      }
    ]
  }
}
